            "body": {
              "mode": "raw",
              "raw": "{\r\n  \"firstname\": \"{{firstName}}\",\r\n  \"lastname\": \"Putta\",\r\n  \"totalprice\": 1500,\r\n  \"depositpaid\": true,\r\n  \"bookingdates\": {\r\n    \"checkin\": \"2026-10-01\",\r\n    \"checkout\": \"2026-10-05\"\r\n  },\r\n  \"additionalneeds\": \"Breakfast\"\r\n}",
