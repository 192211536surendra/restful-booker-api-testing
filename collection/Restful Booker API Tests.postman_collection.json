      "name": "Create_Booking",
      "item": [
        {
          "name": "create booking",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "pm.environment.set(\"firstName\", \"Surendra\" + Math.floor(Math.random() * 1000));"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();\r",
                  "\r",
                  "pm.test(\"Status code is 200\", () => pm.response.to.have.status(200));\r",
                  "\r",
                  "pm.test(\"Booking ID is a number\", () => pm.expect(json.bookingid).to.be.a(\"number\"));\r",
                  "\r",
                  "pm.test(\"Firstname matches request\", () => \r",
                  "    pm.expect(json.booking.firstname).to.eql(pm.environment.get(\"firstName\"))\r",
                  ");\r",
                  "\r",
                  "pm.test(\"Total price matches request\", () => \r",
                  "    pm.expect(json.booking.totalprice).to.eql(1500)\r",
                  ");\r",
                  "\r",
                  "pm.environment.set(\"bookingId\", json.bookingid);\r",
                  "pm.environment.set(\"firstName\", json.booking.firstname);"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
