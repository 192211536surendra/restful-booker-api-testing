    {
      "name": "Read_Booking",
      "item": [
        {
          "name": "Get Booking By ID",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200 or 404\", function () {",
                  "    pm.expect(pm.response.code).to.be.oneOf([200, 404]);",
                  "});",
                  "",
                  "if (pm.response.code === 200) {",
                  "",
                  "    const json = pm.response.json();",
                  "",
                  "    pm.test(\"Content-Type is JSON\", function () {",
                  "        pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/json\");",
                  "    });",
                  "",
                  "    pm.test(\"Firstname is correct\", function () {",
                  "        pm.expect(json.firstname).to.eql(pm.environment.get(\"firstName\"));",
                  "    });",
                  "",
                  "    pm.test(\"Response has bookingdates\", function () {",
                  "        pm.expect(json).to.have.property(\"bookingdates\");",
                  "    });",
                  "",
                  "} else {",
                  "",
                  "    pm.test(\"Response is Not Found\", function () {",
                  "        pm.response.to.have.status(404);",
                  "        pm.expect(pm.response.text()).to.equal(\"Not Found\");",
                  "    });",
                  "",
                  "}"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            },
            {
              "listen": "prerequest",
              "script": {
                "packages": {},
                "type": "text/javascript"
              }
            }
